# Copy to ~/.config/invest-agent-loop.env, set values, then chmod 600 it.
# The agent loop inherits these credentials to its MCP client; never put them
# in the systemd unit or commit this populated file.
DATABASE_URL=postgres://marketdata:marketdata@localhost:5432/marketdata?sslmode=disable
BINANCE_API_KEY=
BINANCE_API_SECRET=
AUTOMATION_ASSETS=BTC,ETH
# Use 1m for initial same-day smoke tests; the runtime default is 1h.
AUTOMATION_TIMEFRAME=1m
CLAUDE_CODE_BIN=/usr/local/bin/claude
CODEX_BIN=/usr/local/bin/codex
AGENT_TIMEOUT=10m
# Optional. Defaults to 15m.
AGENT_LOOP_INTERVAL=15m
